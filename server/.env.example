PORT=4000
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=30d
OTP_HASH_SECRET=replace-with-otp-hash-secret

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=1NjQixzDInVZhGI6jTd9e9kyXG7zzdgEgRvDDuFBqSxs
GOOGLE_SHEETS_SHEET_NAME=Sheet1
GOOGLE_SERVICE_ACCOUNT_JSON=PASTE_JSON_OR_BASE64_HERE

# SMS provider
SMS_PROVIDER_URL=https://your-sms-provider.example/send
SMS_PROVIDER_API_KEY=optional-api-key
SMS_PROVIDER_HEADERS_JSON={"Authorization":"Bearer YOUR_KEY"}
SMS_PROVIDER_BODY_TEMPLATE_JSON={"to":"{{phone}}","message":"{{message}}"}

# OTP behavior
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_RESEND_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5

# CORS
CORS_ORIGIN=http://localhost:5500
